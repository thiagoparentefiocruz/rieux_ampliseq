/*
 * rieux.config — perfil do cluster rieux para o nf-core/ampliseq
 *
 * Uso:  nextflow run <pipeline> -profile singularity -c conf/rieux.config ...
 *
 * Particoes vistas em `sinfo`:
 *   cpu*  3 nos, 256 CPUs, ~515 GB, sem limite de tempo
 *   fat   2 nos, 256 CPUs, ~4 TB,   sem limite de tempo
 *   gpu   2 nos, 256 CPUs, ~515 GB
 *
 * ---------------------------------------------------------------------------
 * UM ARQUIVO SO, PARTICAO POR VARIAVEL DE AMBIENTE
 *
 * Antes havia dois arquivos gemeos, rieux.config e rieux_fat.config, que
 * diferiam em tres linhas. Config duplicada e como a gente volta daqui a seis
 * meses, corrige um e esquece o outro. As tres linhas que variavam viraram
 * variaveis, e quem as define e o rieux_ampliseq.sh a partir de --partition.
 *
 * Rodar dois conjuntos em paralelo, cada um numa particao, continua igual:
 *     rieux_ampliseq.sh --name fabio    --partition cpu
 *     rieux_ampliseq.sh --name patricia --partition fat --work-dir exec/patricia
 *
 * Chamado direto pelo nextflow, sem o wrapper, o arquivo cai nos padroes
 * abaixo — que sao os de antes.
 * ---------------------------------------------------------------------------
 */

// NAO ha bloco plugins{} aqui, de proposito.
//
// O proprio ampliseq 2.15.0 declara `nf-schema@2.4.2` no nextflow.config dele
// — confirmado no .nextflow.log:  Plugins declared=[nf-schema@2.4.2]
// Fixar outra versao aqui sobrescreveria a escolha do pipeline por uma
// combinacao que ninguem testou.
//
// O erro "plugin versions MUST be specified in offline mode" que vimos antes
// nao vinha de falta de pino: vinha de o Nextflow ter sido lancado do
// diretorio de um subworkflow, onde o nextflow.config da raiz — e portanto a
// declaracao do plugin — nunca era lido.

def fila      = System.getenv('RIEUX_QUEUE')      ?: 'cpu'
def filaTax   = System.getenv('RIEUX_QUEUE_TAX')  ?: 'fat'
def memAlta   = System.getenv('RIEUX_MEM_HIGH')   ?: '160'
def tamanhoFila = (System.getenv('RIEUX_QUEUESIZE') ?: '60') as Integer

process {
    executor       = 'slurm'
    queue          = fila

    // scratch = true FICA DESLIGADO de proposito.
    //
    // Com ele, o Nextflow executa a tarefa num diretorio temporario local
    // (/tmp/nxf.XXXX) e pede ao Apptainer para montar esse caminho DENTRO do
    // container, no mesmo lugar. Criar um destino novo dentro da imagem exige
    // overlay gravavel; imagens minimas e Apptainer sem overlay habilitado
    // recusam, com:
    //   FATAL: mount /tmp/nxf.XXXX -> ... destination doesn't exist in container
    // Foi o que derrubou o CUTADAPT_SUMMARY_STD, que roda numa imagem python
    // enxuta — enquanto processos em imagens maiores passaram sem reclamar.
    //
    // Sem scratch, a tarefa roda direto no work/, no armazenamento
    // compartilhado. Custa um pouco de I/O e ganha previsibilidade.

    maxRetries     = 2
    errorStrategy  = { task.exitStatus in [104,134,137,138,139,140,143] ? 'retry' : 'finish' }

    // Os nos tem 256 cores. Nao vale pedir o no inteiro para um passo pequeno:
    // com ~300 amostras x 7 regioes o ganho vem de muitas tarefas medias em
    // paralelo, nao de poucas tarefas gigantes.
    cpus   = 4
    memory = 16.GB

    withLabel: process_low     { cpus = 2;  memory = 12.GB }
    withLabel: process_medium  { cpus = 8;  memory = 48.GB }
    withLabel: process_high    { cpus = 24; memory = "${memAlta}.GB" }

    // assignTaxonomy/addSpecies com SILVA e o unico passo realmente pesado de
    // memoria — vai para a particao gorda mesmo quando o resto nao vai.
    withName: 'DADA2_TAXONOMY|DADA2_ADDSPECIES' {
        cpus   = 16
        memory = 220.GB
        queue  = filaTax
    }

    // O Sidle alinha cada ASV regional contra o banco recortado; e o passo mais
    // pesado do ramo multi-regiao, e escala com o tamanho do banco.
    withName: 'SIDLE_ALIGNREGIONAL|SIDLE_RECONSTRUCTDB|SIDLE_RECONSTRUCTCOUNTS' {
        cpus   = 16
        memory = "${memAlta}.GB"
        queue  = filaTax
    }
}

executor {
    // nao afogar o SLURM: a fila `cpu` tem 3 nos, a `fat` tem 2. O wrapper
    // ajusta este numero conforme a particao escolhida.
    queueSize       = tamanhoFila
    submitRateLimit = '20/1min'
}

singularity {
    enabled    = true
    autoMounts = true
    // cacheDir NAO e declarado aqui de proposito: o Nextflow ja honra
    // NXF_SINGULARITY_CACHEDIR sozinho, e e o bin/ambiente.sh que a define a
    // partir do RIEUX_PIPELINE_BASE de cada usuario. Declarar de novo so criaria
    // um segundo lugar para a mesma verdade — e antes havia aqui um caminho
    // pessoal cravado, que quebrava para qualquer outra pessoa.
}

// NAO existe bloco env{} com NXF_* aqui, de proposito.
//
// O escopo env{} do Nextflow define variaveis para as TAREFAS, nao para o
// processo que conduz o pipeline. E as tarefas nao executam Nextflow — quem
// resolve plugins e interpreta config e o driver. Pior: NXF_SYNTAX_PARSER
// precisa valer ANTES de o arquivo ser lido, entao declara-lo aqui dentro nao
// teria como funcionar nem em principio.
//
// Essas variaveis vao em bin/ambiente.sh, carregado antes de chamar o nextflow.

report  { enabled = true }
timeline{ enabled = true }
trace   { enabled = true }
